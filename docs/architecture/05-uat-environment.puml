@startuml 05-uat-environment
!include _c4.iuml
title Clear Measure work orders demo 3 (AKS and Argo CD) | Progression: uat added and promoted (2026-10-04)

Person(viewer, "Class audience", "Browser")
Person(approver, "Space Manager", "Signs off a promotion, with a recorded note")

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "cmdemo3-system", "system repository", "system.json lists tdd, uat; gitops/argocd/apps/environment-uat.yaml; gitops/environments/uat", $tags="new")
  Container(apprepo, "cmdemo3-workorders", "app repository", "Build, then Release, for every green master")
}

Boundary(octo, "Octopus space cmdemo3 demo") {
  Container(lifecycle, "cmdemo3-lifecycle", "lifecycle", "tdd (automatic), then uat (promotion with sign-off)", $tags="new")
  Container(instance, "Argo CD instance argocd-cmdemo3", "gateway", "Serves tdd and uat", $tags="new")
  Container(proj_sys, "cmdemo3-system", "project", "tdd 1.0.6, uat 1.0.6", $tags="new")
  Container(proj_app, "cmdemo3-ui", "project", "tdd 2.4.2, uat 2.4.2", $tags="new")
}

Boundary(aksb, "aks-cmdemo3 in rg-cmdemo3-cluster") {
  Container(argocd, "Argo CD", "namespace argocd", "Applications of tdd and uat", $tags="new")
  Container(ingress, "Envoy Gateway", "20.225.155.175", "Listeners https-tdd, https-uat", $tags="new")
  Container(k8sworker, "Octopus Kubernetes worker", "namespace octopus-worker")
  Boundary(tdd, "Namespace cmdemo3-tdd") {
    Container(tdd_app, "ui", "Deployment", "https://cmdemo3-tdd.20-225-155-175.sslip.io")
    ContainerDb(tdd_sql, "db", "SQL Server 2022 Express")
  }
  Boundary(uat, "Namespace cmdemo3-uat") {
    Container(uat_app, "ui", "Deployment", "https://cmdemo3-uat.20-225-155-175.sslip.io", $tags="new")
    ContainerDb(uat_sql, "db", "SQL Server 2022 Express, its own disk and credentials", $tags="new")
  }
}

Rel(sysrepo, lifecycle, "pull request merged: octopus-apply adds uat", $tags="new")
Rel(sysrepo, instance, "cluster-apply: the instance serves uat too", $tags="new")
Rel(approver, proj_sys, "signs off the promotion to uat", $tags="new")
Rel(approver, proj_app, "signs off the promotion to uat", $tags="new")
Rel(proj_sys, sysrepo, "promote to uat: commits gitops/environments/uat/system", $tags="new")
Rel(proj_app, sysrepo, "promote to uat: commits the image tag", $tags="new")
Rel(proj_app, k8sworker, "Migrate database, Seed demo employees, Verify", $tags="new")
Rel(argocd, sysrepo, "reads the commits")
Rel(argocd, uat, "applies", $tags="new")
Rel(k8sworker, uat_sql, "database steps", $tags="new")
Rel(viewer, ingress, "HTTPS")
Rel(ingress, uat_app, "route", $tags="new")
Rel(ingress, tdd_app, "route")

SHOW_LEGEND()
@enduml
