@startuml 02-azure-seed
!include _c4.iuml
title Clear Measure work orders demo 3 (AKS and Argo CD) | Phase 2: Azure seed (2026-10-04)

Boundary(box, "Operator machine omarchy") {
  Container(aiops, "Linux user aiops", "az as cm-ai-ops", "Ran new-demo-seed.ps1: seed.bicep at subscription scope")
}

Boundary(sub, "Subscription Jeffrey MVP Azure subscription 7-25--7-27 (southcentralus)") {
  Boundary(rgn, "rg-cmdemo3-nonprod") {
    ContainerDb(acr, "acrcmdemo3q3zmsi", "Container Registry, Basic", "Images cmdemo3/ui:<version>", $tags="new")
    ContainerDb(tfstate, "stcmdemo3tfq3zmsi", "Storage account", "Terraform state of octopus/ (container tfstate)", $tags="new")
    Container(id_plan, "id-cmdemo3-plan", "managed identity", "Reader on the groups: previews and drift", $tags="new")
    Container(id_cfg, "id-cmdemo3-octopus-config", "managed identity", "Storage Blob Data Contributor on the state account", $tags="new")
    Container(id_push, "id-cmdemo3-acr-push", "managed identity", "AcrPush on the registry", $tags="new")
  }
  Boundary(rgc, "rg-cmdemo3-cluster") {
    Container(id_cluster, "id-cmdemo3-cluster", "managed identity", "Contributor of rg-cmdemo3-cluster: the cluster job applies the cluster", $tags="new")
    Container(id_aks, "id-cmdemo3-aks", "managed identity", "The cluster's own identity", $tags="new")
    Container(id_kubelet, "id-cmdemo3-kubelet", "managed identity", "The nodes: AcrPull on the registry", $tags="new")
    Container(id_feed, "id-cmdemo3-feed", "managed identity", "Octopus container feed: AcrPull on the registry", $tags="new")
    Container(pip, "pip-cmdemo3-ingress", "public IP, static", "20.225.155.175: the host names *.20-225-155-175.sslip.io", $tags="new")
    Container(aks, "aks-cmdemo3", "AKS cluster", "Every environment is a namespace: tdd, uat, prod", $tags="planned")
  }
  Boundary(rgp, "rg-cmdemo3-prod") {
    Container(prod_note, "No resources", "runtime aks-argocd", "The prod environment runs in the one cluster")
  }
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "cmdemo3-system", "environments azure-read, octopus", $tags="planned")
  Container(apprepo, "cmdemo3-workorders", "environment release", $tags="planned")
}

Boundary(octo, "Octopus space cmdemo3 demo") {
  Container(feed, "Feed acr-cmdemo3", "container feed, OIDC", "Subject space:cmdemo3-demo:feed:acr-cmdemo3", $tags="planned")
}

Rel(aiops, sub, "deployment seed-cmdemo3", "Owner", $tags="new")
Rel(sysrepo, id_plan, "federated: environment azure-read", $tags="planned")
Rel(sysrepo, id_cfg, "federated: environment octopus", $tags="planned")
Rel(sysrepo, id_cluster, "federated: environment octopus", $tags="planned")
Rel(apprepo, id_push, "federated: environment release", $tags="planned")
Rel(feed, id_feed, "federated", $tags="planned")
Rel(id_cfg, tfstate, "state", $tags="new")
Rel(id_push, acr, "push", $tags="new")
Rel(id_kubelet, acr, "pull", $tags="new")
Rel(id_feed, acr, "read versions", $tags="new")
Rel(id_cluster, aks, "creates", $tags="planned")
Rel(aks, pip, "ingress", $tags="planned")

SHOW_LEGEND()
@enduml
