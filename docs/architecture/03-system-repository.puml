@startuml 03-system-repository
!include _c4.iuml
title Clear Measure work orders demo 3 (AKS and Argo CD) | Phase 3: system repository pushed (2026-10-04)

Boundary(box, "Operator machine omarchy") {
  Container(aiops, "Linux user aiops", "gh as cm-ai-ops-bot", "Ran new-system-repository.ps1")
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "cmdemo3-system", "public repository, main protected by ruleset", "system.json, infra/, cluster/, gitops/, octopus/, scripts/, docs/architecture/", $tags="new")
  Container(wf_system, "Workflow system", "GitHub Actions, every merge to main", "octopus-apply, cluster-apply, system-release", $tags="new")
  Container(wf_checks, "Workflow env-checks", "GitHub Actions", "Pull request checks: system.json, gitops/, Terraform, Bicep", $tags="new")
  Container(board, "Project board", "GitHub Project", "Work items of the demo", $tags="new")
}

Boundary(octo, "Octopus space cmdemo3 demo") {
  Container(sa, "cmdemo3-github", "service account", "OIDC identity for environment octopus")
  Container(octo_cfg, "Environments, lifecycle, feeds, Git credential, worker pool, projects", "Terraform octopus/, from system.json", "Created by the first octopus-apply", $tags="planned")
  Container(instance, "Argo CD instance argocd-cmdemo3", "Octopus Argo CD Gateway", "Registered by cluster-apply for tdd", $tags="planned")
  Container(worker, "Worker cmdemo3-worker", "Kubernetes worker, pool cmdemo3-cluster", "Registered by cluster-apply", $tags="planned")
  Container(rel_sys, "cmdemo3-system release 1.0.<run>", "a commit of cmdemo3-system", "Deploys to tdd automatically", $tags="planned")
}

Boundary(sub, "Subscription Jeffrey MVP Azure subscription 7-25--7-27") {
  ContainerDb(tfstate, "stcmdemo3tfq3zmsi", "Storage account", "octopus.tfstate")
  ContainerDb(acr, "acrcmdemo3q3zmsi", "Container Registry", "cmdemo3/ui:0.0.0-placeholder", $tags="new")
  Container(id_cfg, "id-cmdemo3-octopus-config", "managed identity")
  Container(id_cluster, "id-cmdemo3-cluster", "managed identity", "Contributor of rg-cmdemo3-cluster")
  Boundary(aksb, "aks-cmdemo3 (stack-cmdemo3-cluster)") {
    Container(argocd, "Argo CD", "namespace argocd", "Applies gitops/ of cmdemo3-system", $tags="planned")
    Container(gateway, "Octopus Argo CD Gateway", "namespace octopus-argocd-gateway", "Connects out to Octopus", $tags="planned")
    Container(k8sworker, "Octopus Kubernetes worker", "namespace octopus-worker", "Polls Octopus", $tags="planned")
    Container(ingress, "Envoy Gateway, cert-manager", "platform", "HTTPS on 20.225.155.175", $tags="planned")
  }
}

Rel(aiops, sysrepo, "creates, pushes main; variables, environments, secret OCTOPUS_GITHUB_TOKEN", $tags="new")
Rel(aiops, acr, "imports the placeholder image", $tags="new")
Rel(sysrepo, wf_system, "push to main", $tags="new")
Rel(wf_system, sa, "OctopusDeploy/login", "OIDC", $tags="new")
Rel(wf_system, id_cfg, "azure/login", "OIDC", $tags="new")
Rel(wf_system, id_cluster, "azure/login", "OIDC", $tags="new")
Rel(id_cfg, tfstate, "state")
Rel(wf_system, octo_cfg, "terraform apply", $tags="planned")
Rel(id_cluster, argocd, "cluster stack, Helm", $tags="planned")
Rel(gateway, instance, "registers, one-hour token", $tags="planned")
Rel(k8sworker, worker, "registers, one-hour token", $tags="planned")
Rel(wf_system, rel_sys, "create release", $tags="planned")
Rel(argocd, sysrepo, "reads gitops/", $tags="planned")

SHOW_LEGEND()
@enduml
